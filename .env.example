# demo não chama serviços externos. live exige OpenAI, Zep e bridge Python.
MODE=demo
HOST=127.0.0.1
PORT=3100
DATA_DIR=./data
# Obrigatória se HOST não for loopback; recomendada também em uso local.
API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ZEP_API_KEY=
BRIDGE_URL=http://127.0.0.1:8100
# Use o mesmo segredo no Node e no serviço Python.
BRIDGE_TOKEN=
BRIDGE_DATA_DIR=./data/bridge
MAX_LLM_CALLS=200
